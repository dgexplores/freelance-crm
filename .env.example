# ---------------------------------------------------------------------------
# freelance-crm environment template
# Copy to .env (local) or paste into Vercel project settings (production).
# Never commit real .env files.
# ---------------------------------------------------------------------------

# --- Required ---

# PostgreSQL connection string.
# Local default matches docker-compose.yml; use your Neon/Supabase URL in prod.
DATABASE_URL="postgresql://freelance:freelance@localhost:5432/freelance"

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud Console -> Credentials).
# Authorized redirect URI must include:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://your-domain.com/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Protects GET /api/cron/stale-followups. Generate with: openssl rand -base64 32
CRON_SECRET=""

# Token encryption (AES-256-GCM) for OAuth tokens stored in Account.
# Not wired into better-auth yet – helper only (src/lib/token-crypto.ts).
# Falls back to BETTER_AUTH_SECRET if unset. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Optional: AI features ---
# Google AI Studio key. Without it, AI endpoints return 503 gracefully.
GEMINI_API_KEY=""

# --- Optional: error monitoring ---
# Client bundle inlines only NEXT_PUBLIC_* vars at build time, so the
# browser DSN must use the NEXT_PUBLIC_ prefix. SENTRY_DSN covers
# server/edge runtimes.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_ENVIRONMENT=""

# --- Optional: demo mode without Google OAuth ---
# DEV_BYPASS_AUTH=true skips the sign-in gate and auto-creates dev@local.test.
# Local dev: safe. Vercel prod: ONLY for UI preview – all demo data is public.
# Never set alongside real user data.
DEV_BYPASS_AUTH=""

# --- Optional: database backups (scripts/backup-db.sh) ---
# Must match BACKUP_DIR default in scripts/backup-db.sh and scripts/restore-db.sh.
BACKUP_DIR="/var/backups/freelance-crm"
RETENTION_DAYS="30"
