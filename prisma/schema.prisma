generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DealStage {
  INBOX
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  emailVerified      Boolean   @default(false) // better-auth
  name               String?
  image              String? // better-auth avatar
  rateCard           String? // markdown: rates, services, terms
  gmailSyncStartedAt DateTime? // forward-only import boundary (first run)
  staleDays          Int      @default(5) // idle days before a deal counts as stale (1-30)
  autoFollowUp       Boolean  @default(true) // daily cron may schedule follow-ups
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  contacts           Contact[]
  deals              Deal[]
  emails             Email[]
  facts              Fact[]
  accounts           Account[]
  sessions           Session[]
  subscription       Subscription?
}

// better-auth tables (Google OAuth, sessions)
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                   String    @id
  accountId            String
  providerId           String
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SECURITY: access/refresh/id tokens stored plaintext (better-auth writes
  // these directly). Needs TOKEN_ENCRYPTION_KEY envelope (see
  // src/lib/token-crypto.ts) before public launch. No schema change needed:
  // encrypted payload fits in the existing String columns.
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Stripe billing + AI metering (one row per user, created on first checkout).
model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String?
  stripeSubId      String?
  status           String   @default("free") // free | active | past_due | canceled
  aiUsed           Int      @default(0)
  periodStart      DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Contact {
  id          String   @id @default(cuid())
  email       String
  name        String?
  company     String?
  linkedinUrl String?
  source      String? // how they arrived: inbound, referral, outbound
  lastContact DateTime?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  deals       Deal[]
  emails      Email[]
  facts       Fact[]
  createdAt   DateTime @default(now())

  @@unique([userId, email])
}

model Deal {
  id            String    @id @default(cuid())
  title         String
  stage         DealStage @default(INBOX)
  value         Int? // in dollars, estimated
  whyInPipeline String?   // evidence: the email/context that put it here
  source        String?
  wonAt         DateTime?
  lostReason    String?
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  tasks         Task[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, stage, updatedAt])
  @@index([userId, contactId])
}

model Email {
  id        String         @id @default(cuid())
  gmailId   String
  threadId  String?
  subject   String
  fromAddr  String
  body      String
  direction EmailDirection
  receivedAt DateTime
  sentiment String? // AI: positive, neutral, negative
  action    String? // AI: what it means for the pipeline
  contactId String?
  contact   Contact?       @relation(fields: [contactId], references: [id])
  userId    String
  user      User           @relation(fields: [userId], references: [id])

  @@unique([userId, gmailId])
  @@index([userId, receivedAt])
  @@index([contactId, receivedAt])
}

model Task {
  id        String   @id @default(cuid())
  kind      String // follow_up, brief, proposal
  dueAt     DateTime
  reason    String // why the agent scheduled it
  done      Boolean  @default(false)
  doneAt    DateTime?
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id])
  createdAt DateTime @default(now())

  // No @@unique here on purpose: a deal legitimately accrues many done
  // tasks over its lifetime (the old @@unique([dealId, kind, done]) capped
  // history at 1 done row ever). Pending-task idempotency is enforced at
  // the application level (findFirst done:false before create); the P2002
  // catch in scheduler.ts is retained as a harmless race guard.
  @@index([dealId, kind, done])
  @@index([dueAt])
}

model Fact {
  id        String   @id @default(cuid())
  claim     String
  source    String // signature-block, email, linkedin, web
  strength  String // strong, suggestion — never guessed
  applied   Boolean  @default(false) // written into the record or not
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([contactId])
}